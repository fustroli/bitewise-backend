# App env for a load-test run: copy to loadtest.env (gitignored) and pass with
#   node --env-file=test/load/loadtest.env dist/main.js
# Values here win over .env (dotenv never overrides an already-set variable).
# Keep everything prod-like except what the comments call out.

PORT=8000
FRONTEND_URL=http://localhost:3000
NODE_ENV=production
LOG_LEVEL=warn

# Per-client limit (each k6 User has its own IP). A VU does ~30 req/min; keep prod's
# value if it's above that, so the throttler costs what it costs in prod.
THROTTLER_LIMIT=120
THROTTLER_TTL=60000
# k6 sends X-Forwarded-For per User. 1 = k6 hits Node directly;
# 2 = k6 hits nginx (nginx appends its peer, like prod's CloudFront + nginx)
TRUST_PROXY_HOPS=1

# Isolated database, never the dev or prod one
TYPEORM_HOST=127.0.0.1
TYPEORM_PORT=3307
TYPEORM_USERNAME=root
TYPEORM_PASSWORD=loadtest
TYPEORM_DATABASE_DEV=bitewise_loadtest

ACCESS_TOKEN_SECRET=loadtest-access-secret-change-me-0123456789
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_SECRET=loadtest-refresh-secret-change-me-0123456789
REFRESH_TOKEN_EXPIRATION=7d
# Same cost as prod: sign-in cost is part of what's measured
SALT_WORK_FACTOR=12

# Never called (no OAuth or avatar traffic), but required at boot
GOOGLE_CLIENT_ID=unused
GOOGLE_SECRET=unused
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback
GCP_PROJECT_ID=unused
GCP_PRIVATE_KEY_FILE=unused.json
GCP_BUCKET_NAME=unused
