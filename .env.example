# Validated at boot and before migrations (src/config/env.validation.ts):
# the app refuses to start, listing every invalid key. Optional keys may be left empty.

# HTTP port the API listens on
PORT=
# Frontend origin allowed by CORS, with protocol (e.g. http://localhost:3000)
FRONTEND_URL=
# Optional cookie Domain attribute (e.g. .bitewise.example)
COOKIE_DOMAIN=
# Max requests per client per THROTTLER_TTL window
THROTTLER_LIMIT=
# Throttling window in milliseconds (e.g. 60000 = 1 minute)
THROTTLER_TTL=
# Optional: reverse proxies in front of the app (prod: CloudFront + nginx = 2); default 0
TRUST_PROXY_HOPS=
# Optional: ms readiness (/api/health/ready) reports down on shutdown before the server
# closes, so a load balancer polling it drains first; default 0 (no LB polls it in prod)
SHUTDOWN_DRAIN_MS=

# Database the app and migrations connect to
TYPEORM_HOST=
TYPEORM_PORT=
TYPEORM_USERNAME=
TYPEORM_PASSWORD=
TYPEORM_DATABASE_DEV=

# Not read by the app
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=

# JWT secrets: at least 32 characters, e.g. `openssl rand -base64 48`
# Expirations: durations like 15m, 1h, 7d
ACCESS_TOKEN_EXPIRATION=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_EXPIRATION=
REFRESH_TOKEN_SECRET=

# bcrypt cost factor, integer 10–31 (12 is a sensible default)
SALT_WORK_FACTOR=
# development | production | test (production enables Secure cookies)
NODE_ENV=
# Optional: true | false — serve Swagger at /api/docs; default true except in production
SWAGGER_ENABLED=
# Optional: fatal | error | warn | info | debug | trace | silent; default debug in development,
# silent in test, info otherwise
LOG_LEVEL=

# Google OAuth; callback URL with protocol
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_CALLBACK_URL=
